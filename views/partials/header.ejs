<% const current = typeof activePage !== 'undefined' ? activePage : ''; %>
<div class="utility-bar">
    <div class="utility-inner">
        <a href="tel:+14848416445" class="utility-link">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2Z"/></svg>
            <span>Call or text Carol: (484) 841-6445</span>
        </a>
    </div>
</div>

<header class="site-header" id="site-header">
    <div class="header-inner">
        <a class="site-logo" href="/">
            <img
                src="/img/optimized/brand-mark-110.jpg"
                srcset="/img/optimized/brand-mark-110.jpg 1x, /img/optimized/brand-mark-220.jpg 2x"
                alt=""
                width="44"
                height="40"
                class="brand-mark"
            >
            <span class="brand-text">
                <span class="brand-name">Arioso Quartet</span>
                <span class="brand-tagline">Philadelphia String Ensemble</span>
            </span>
        </a>

        <nav class="site-nav" aria-label="Primary">
            <button
                class="menu-button"
                type="button"
                popovertarget="site-menu"
                popovertargetaction="toggle"
                aria-controls="site-menu"
            >
                <svg class="icon menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M3 6h18v2H3V6Zm0 5h18v2H3v-2Zm0 5h18v2H3v-2Z"/>
                </svg>
                <span>Menu</span>
            </button>

            <ul id="site-menu" class="site-menu" popover="auto">
                <li><a href="/" <%- current === 'index' ? 'aria-current="page"' : '' %>>Home</a></li>
                <li><a href="/music" <%- current === 'music' ? 'aria-current="page"' : '' %>>Music</a></li>
                <li><a href="/about" <%- current === 'about' ? 'aria-current="page"' : '' %>>About</a></li>
                <li><a href="/reviews" <%- current === 'reviews' ? 'aria-current="page"' : '' %>>Reviews</a></li>
                <li><a href="/rates" <%- current === 'rates' ? 'aria-current="page"' : '' %>>Rates &amp; FAQ</a></li>
                <li class="menu-contact-item">
                    <a href="/rates#inquiry-form" class="nav-cta">Check Dates</a>
                </li>
            </ul>
        </nav>
    </div>
</header>
