<%
  const allVenues = typeof venuesData !== 'undefined' ? venuesData : [];
  const regions = typeof regionMeta !== 'undefined' ? regionMeta : {};

  const bios = [
    {
      name: 'Igor Szwec', role: 'Violinist',
      summary: 'Concertmaster, AVA Opera Orchestra \u2022 Assistant Concertmaster, Opera Philadelphia',
      img: 'igor-close', w: 952, h: 1440, priority: true,
      text: 'Mr. Szwec studied with Jaro Megasiuk (student of George Enesco) and Karen Tuttle (student of Primrose and Casals). He is currently Concertmaster of the AVA Opera Orchestra and West Jersey Chamber Orchestra, as well as Assistant Concertmaster of Opera Philadelphia. He is an active chamber musician, playing with the Arcadian Piano Trio and the Meiravi String Quartet.'
    },
    {
      name: 'Barbara Jaffe', role: 'Violinist',
      summary: 'Concertmaster, Orchestra Concordia \u2022 M.M., Eastman School of Music',
      img: 'barb-close', w: 620, h: 846, priority: true,
      text: 'Ms. Jaffe earned her M.M. from the Eastman School of Music, studying with Donald Weilerstein. She has performed chamber music extensively, having held positions as first violinist in the Cascade (MT) and Bradley (IL) String Quartets. Ms. Jaffe is a founding member of Elysian Camerata, a Philadelphia chamber ensemble. She is concertmaster of Orchestra Concordia and performs with the Pennsylvania Sinfonia Orchestra, and is the music director of Vermont Music and Arts, a summer chamber music program for adults. She maintains a private teaching studio in her home.'
    },
    {
      name: 'Carol Briselli', role: 'Violist & Ensemble Director',
      summary: 'Assistant Principal Violist, Opera Philadelphia \u2022 Teaches at Bryn Mawr, Haverford & Swarthmore',
      img: 'carol-close', w: 1000, h: 1381, priority: false,
      text: 'Ms. Briselli received her M.M. from Temple University and B.A. from SUNY-Binghamton, studying with Toby Appel, Sol Greitzer, and Evelyn Jacobs Luise. She is Assistant Principal Violist of Opera Philadelphia, and also performs with the Pennsylvania Ballet, Philly Pops, and Vox Ama Deus. She was Assistant Professor of Music at West Chester University until 2016, and presently teaches at Bryn Mawr, Haverford, and Swarthmore Colleges, in addition to maintaining a private studio in her home.'
    },
    {
      name: 'Vivian Barton', role: 'Cellist',
      summary: 'Assistant Principal Cellist, Opera Philadelphia \u2022 Curtis Institute graduate',
      img: 'vivian-close', w: 900, h: 1312, priority: false,
      text: "Ms. Barton graduated from the Curtis Institute of Music, studying with David Soyer. Her diverse musical activities include performances with the Brandenburg Ensemble, the Orpheus Chamber Orchestra, and the Philadelphia Orchestra. She has served as Assistant Principal Cellist of the Santa Fe Opera and currently holds the same position with Opera Philadelphia, along with being Principal Cellist of the Academy of Vocal Arts Opera Orchestra. An avid chamber musician, Ms. Barton has been invited to attend the Marlboro Music Festival and the International Musicians' Seminar in Prussia Cove, England."
    }
  ];

  const venuesSchema = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Selected Wedding & Event Venues Played by Arioso String Quartet',
    numberOfItems: allVenues.length,
    itemListElement: allVenues.map((v, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      item: {
        '@type': 'Place',
        name: v.name,
        address: {
          '@type': 'PostalAddress',
          addressLocality: v.city,
          addressRegion: v.state,
          addressCountry: 'US'
        }
      }
    }))
  };
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head.ejs', {
        canonicalPath: '/about',
        pageTitle: 'About the Musicians & Venues',
        pageDescription: 'Meet violinists Igor Szwec and Barbara Jaffe, violist Carol Briselli, and cellist Vivian Barton, and browse 85+ Philadelphia-area, New Jersey and Delaware venues where the Arioso String Quartet has performed.',
        extraJsonLd: venuesSchema
    }) %>
</head>
<body>
    <%- include('../partials/header.ejs', { activePage: 'about' }) %>

    <main id="main-content">
        <section class="page-hero">
            <div class="container">
                <span class="section-kicker">The Ensemble</span>
                <h1 class="page-heading">Meet the Arioso Quartet</h1>
                <p class="page-intro">
                    We trained at the Curtis Institute of Music, the Eastman School of Music, and Temple University, and we hold principal and concertmaster chairs with Philadelphia's opera, ballet, and chamber orchestras.
                </p>
                <nav class="subnav" aria-label="On this page">
                    <a href="#bios" class="chip">Musicians</a>
                    <a href="#venues" class="chip">Venues</a>
                </nav>
            </div>
        </section>

        <section class="section" id="bios">
            <div class="container">
                <div class="bio-grid">
                    <% bios.forEach((b) => { %>
                    <article class="bio-card">
                        <div class="bio-photo-wrap">
                            <img
                                src="/img/optimized/<%= b.img %>-640.jpg"
                                srcset="/img/optimized/<%= b.img %>-320.jpg 320w, /img/optimized/<%= b.img %>-640.jpg 640w"
                                sizes="(min-width: 32rem) 9.5rem, 11rem"
                                alt="<%= b.name %>, <%= b.role %>"
                                width="<%= b.w %>"
                                height="<%= b.h %>"
                                <%- b.priority ? 'fetchpriority="high"' : 'loading="lazy"' %>
                                class="bio-photo"
                            >
                        </div>
                        <div class="bio-content">
                            <span class="instrument-badge"><%= b.role %></span>
                            <h2 class="bio-name"><%= b.name %></h2>
                            <p class="bio-summary"><%= b.summary %></p>
                            <details class="bio-more">
                                <summary>Read full bio</summary>
                                <p class="bio-text"><%= b.text %></p>
                            </details>
                        </div>
                    </article>
                    <% }) %>
                </div>
            </div>
        </section>

        <section class="section section-tinted" id="venues">
            <div class="container">
                <div class="section-header section-header-left">
                    <span class="section-kicker">Where We Perform</span>
                    <h2 class="section-title section-title-left">Venues We've Played</h2>
                    <p class="section-subtitle section-subtitle-left">
                        Historic mansions, gardens, country clubs, hotels, churches, and synagogues across the region. Don't see yours? We perform at any indoor or shaded outdoor location within 80 miles of Center City Philadelphia.
                    </p>
                </div>

                <search class="venue-controls" aria-label="Search and filter venues">
                    <div class="search-input-wrap">
                        <svg class="icon search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5Zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Z"/></svg>
                        <input
                            type="search"
                            id="venue-search"
                            class="search-input"
                            placeholder="Search a venue or town (e.g., Winterthur, Doylestown)..."
                            aria-label="Search venues or towns"
                            autocorrect="off"
                            autocapitalize="none"
                            spellcheck="false"
                        >
                    </div>
                    <div class="filter-pills" role="group" aria-label="Filter venues by region">
                        <button type="button" class="filter-pill is-active" data-region-filter="all">All (<%= allVenues.length %>)</button>
                        <button type="button" class="filter-pill" data-region-filter="philadelphia">Philadelphia</button>
                        <button type="button" class="filter-pill" data-region-filter="pa-suburbs">Main Line &amp; PA Suburbs</button>
                        <button type="button" class="filter-pill" data-region-filter="delaware">Delaware</button>
                        <button type="button" class="filter-pill" data-region-filter="new-jersey">New Jersey</button>
                        <button type="button" class="filter-pill" data-region-filter="greater-region">Lehigh Valley, Hershey &amp; MD</button>
                    </div>
                </search>

                <div class="venues-sections" id="venues-container">
                    <% Object.entries(regions).forEach(([regionKey, regionTitle]) => {
                        const regionVenues = allVenues.filter((v) => v.region === regionKey);
                    %>
                    <details class="venue-category-card" data-venue-region="<%= regionKey %>" <%- regionKey === 'philadelphia' ? 'open' : '' %>>
                        <summary class="venue-category-header">
                            <span class="venue-region-name"><%= regionTitle %></span>
                            <span class="venue-count" data-region-count><%= regionVenues.length %> Venues</span>
                        </summary>
                        <ul class="venue-list">
                            <% regionVenues.forEach((venue) => { %>
                            <li>
                                <strong><%= venue.name %></strong>
                                <span><%= venue.city %>, <%= venue.state %></span>
                            </li>
                            <% }) %>
                        </ul>
                    </details>
                    <% }) %>
                </div>

                <p id="venue-no-results" class="empty-state" hidden>
                    No listed venues match your search, but we perform at any indoor or shaded outdoor location within 80 miles of Center City Philadelphia! <a href="/rates#inquiry-form">Ask about your venue</a>.
                </p>
            </div>
        </section>
    </main>

    <%- include('../partials/footer.ejs') %>
</body>
</html>
