<%
  const baseUrl = typeof siteUrl !== 'undefined' ? siteUrl : 'https://ariosoquartet.com';
  const reviewsSchema = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Arioso String Quartet Client Reviews',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        item: {
          '@type': 'Review',
          itemReviewed: { '@id': baseUrl + '/#ensemble' },
          author: { '@type': 'Person', name: 'Casey H.' },
          datePublished: '2024-09-20',
          name: 'Touch of elegance',
          reviewBody: 'Arioso Quartet was the perfect addition to our wedding ceremony! They added just the touch of elegance we were looking for. Carol was easy to communicate with and helpful in choosing our music for both the ceremony and cocktail hour.',
          reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' }
        }
      },
      {
        '@type': 'ListItem',
        position: 2,
        item: {
          '@type': 'Review',
          itemReviewed: { '@id': baseUrl + '/#ensemble' },
          author: { '@type': 'Person', name: 'Kristin B.' },
          datePublished: '2021-09-12',
          name: 'At the price they charge, they are an absolute steal',
          reviewBody: 'ARIOSO played so beautifully for our ceremony. Carol was fantastic to work with and I am still very grateful to her for personally arranging the music for my walk down the aisle. At the price they charge, they are an absolute steal.',
          reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' }
        }
      },
      {
        '@type': 'ListItem',
        position: 3,
        item: {
          '@type': 'Review',
          itemReviewed: { '@id': baseUrl + '/#ensemble' },
          author: { '@type': 'Person', name: 'Betsy Z.' },
          datePublished: '2019-05-20',
          name: 'I Would Highly Recommend You to Anyone',
          reviewBody: 'Vivian was lovely and the quartet was just perfect. We had many compliments and Mallory was just delighted. I would highly recommend you to anyone as you are extremely talented and represent the utmost in professionalism.',
          reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' }
        }
      }
    ]
  };
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head.ejs', {
        canonicalPath: '/testimonials',
        pageTitle: 'Client Testimonials & Reviews',
        pageDescription: 'Read 5-star reviews and wedding testimonials for the Arioso String Quartet from couples and families across the Greater Philadelphia area.',
        extraJsonLd: reviewsSchema
    }) %>
</head>
<body>
    <%- include('../partials/header.ejs', { activePage: 'testimonials' }) %>

    <main id="main-content">
        <section class="page-hero">
            <div class="container testimonials-hero-inner">
                <div>
                    <span class="section-kicker">5-Star Client Experiences</span>
                    <h1 class="page-heading">Client Testimonials</h1>
                    <p class="page-intro">
                        Read what couples, parents, and event hosts have shared about working with Carol Briselli and the Arioso String Quartet on The Bash, WeddingWire, and Thumbtack.
                    </p>
                </div>
                <a class="hero-awards-cluster" href="https://www.thebash.com/string-quartet/arioso-quartet" target="_blank" rel="noopener noreferrer" aria-label="View Arioso Quartet profile on The Bash">
                    <img src="/img/awards/bash-25.svg" alt="The Bash 25 Years Award" width="68" height="68" fetchpriority="high">
                    <img src="/img/awards/bash-best-of.svg" alt="The Bash Best Of Award" width="68" height="68">
                    <img src="/img/awards/bash-lifetime-award.svg" alt="The Bash Lifetime Award" width="68" height="68">
                    <img src="/img/awards/bash-rapid.svg" alt="The Bash Rapid Responder" width="68" height="68">
                </a>
            </div>
        </section>

        <section class="section">
            <div class="container">
                <div class="reviews-grid">
                    <article class="review-card">
                        <div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <h2 class="review-title">&ldquo;Touch of elegance&rdquo;</h2>
                        <blockquote class="review-body">
                            Arioso Quartet was the perfect addition to our wedding ceremony! They added just the touch of elegance we were looking for. Carol was easy to communicate with and helpful in choosing our music for both the ceremony and cocktail hour. As someone who does not know much about classical music, she made it stress-free for me. We received so many compliments throughout the night about how beautiful the music was, we could not have asked for anything more! We highly recommend booking Arioso!
                        </blockquote>
                        <footer class="review-footer">
                            <strong>Casey H.</strong>
                            <time datetime="2024-09-20">Sept. 20, 2024</time>
                        </footer>
                    </article>

                    <article class="review-card">
                        <div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <h2 class="review-title">
                            <a target="_blank" rel="noopener noreferrer" href="https://www.weddingwire.com/biz/arioso-quartet-chester-heights/938db69417015771.html">
                                &ldquo;At the price they charge, they are an absolute steal&rdquo;
                            </a>
                        </h2>
                        <blockquote class="review-body">
                            ARIOSO played so beautifully for our ceremony. Carol was fantastic to work with and I am still very grateful to her for personally arranging the music for my walk down the aisle. At the price they charge, they are an absolute steal. I would highly recommend them to any one!
                        </blockquote>
                        <footer class="review-footer">
                            <strong>Kristin B.</strong>
                            <time datetime="2021-09-12">Sept. 12, 2021 &bull; WeddingWire</time>
                        </footer>
                    </article>

                    <article class="review-card">
                        <div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <h2 class="review-title">&ldquo;I Would Highly Recommend You to Anyone&rdquo;</h2>
                        <blockquote class="review-body">
                            I wanted to thank you so very much. Vivian was lovely and the quartet was just perfect. I didn’t get to thank anyone after the ceremony. We had many compliments and Mallory was just delighted. I would highly recommend you to anyone as you are extremely talented and represent the utmost in professionalism. Once again - thank you for helping to make Mallory and Dan’s special day even more beautiful.
                        </blockquote>
                        <footer class="review-footer">
                            <strong>Betsy Z.</strong>
                            <time datetime="2019-05-20">May 20, 2019</time>
                        </footer>
                    </article>

                    <article class="review-card">
                        <div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <h2 class="review-title">
                            <a target="_blank" rel="noopener noreferrer" href="https://www.thebash.com/string-quartet/arioso-quartet/feedback">
                                &ldquo;[P]unctual and professional&rdquo;
                            </a>
                        </h2>
                        <blockquote class="review-body">
                            Carol was absolutely wonderful to work with! The quartet was delightful, they accommodated us with our requests and were both punctual and professional. I would highly recommend them for your next event.
                        </blockquote>
                        <footer class="review-footer">
                            <strong>Jill L.</strong>
                            <time datetime="2018-12-01">Dec. 1, 2018 &bull; The Bash</time>
                        </footer>
                    </article>

                    <article class="review-card">
                        <div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <h2 class="review-title">
                            <a target="_blank" rel="noopener noreferrer" href="https://www.weddingwire.com/biz/arioso-quartet-chester-heights/938db69417015771.html">
                                &ldquo;They played beautifully and it added such a nice touch to the day&rdquo;
                            </a>
                        </h2>
                        <blockquote class="review-body">
                            Arioso played during our ceremony and cocktail hour and it was beautiful. They were very professional to work with and I highly recommend working with them. They played beautifully and it added such a nice touch to the day.
                        </blockquote>
                        <footer class="review-footer">
                            <strong>Claire</strong>
                            <time datetime="2018-08-18">Aug. 18, 2018 &bull; WeddingWire</time>
                        </footer>
                    </article>

                    <article class="review-card">
                        <div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <h2 class="review-title">
                            <a target="_blank" rel="noopener noreferrer" href="https://www.thebash.com/string-quartet/arioso-quartet/feedback">
                                &ldquo;Absolutely Loved Their Performance&rdquo;
                            </a>
                        </h2>
                        <blockquote class="review-body">
                            Although I didn't get the opportunity to enjoy all the music they performed during my wedding, I absolutely loved their performance of Pachelbel as my dad and I walked down the aisle :) I was told that all the guests loved their music and that having them play at our wedding gave it the perfect touch of elegance. Their quality is great and their price was much more reasonable than other trios/quartets I could find. Thanks for sharing your wonderful music!
                        </blockquote>
                        <footer class="review-footer">
                            <strong>Kelsi A.</strong>
                            <time datetime="2017-09-30">Sept. 30, 2017</time>
                        </footer>
                    </article>

                    <article class="review-card">
                        <div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <h2 class="review-title">
                            <a target="_blank" rel="noopener noreferrer" href="https://www.thebash.com/string-quartet/arioso-quartet/feedback">
                                &ldquo;My Highest Recommendation&rdquo;
                            </a>
                        </h2>
                        <blockquote class="review-body">
                            Our event was a wonderful evening wedding enriched by the fabulous professional talent of Arioso. Arioso has my highest recommendation.
                        </blockquote>
                        <footer class="review-footer">
                            <strong>Marta S.</strong>
                            <time datetime="2017-07-22">Jul. 22, 2017</time>
                        </footer>
                    </article>

                    <article class="review-card">
                        <div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <h2 class="review-title">
                            <a target="_blank" rel="noopener noreferrer" href="https://www.thumbtack.com/pa/chester-heights/string-quartet-for-hire/sophisticated-string-group-for-weddings">
                                &ldquo;Professionalism and Prompt Communication&rdquo;
                            </a>
                        </h2>
                        <blockquote class="review-body">
                            We hired Arioso Quartet to play at my wedding ceremony. They were fantastic and very helpful during the planning process!
                        </blockquote>
                        <footer class="review-footer">
                            <strong>Thumbtack Client</strong>
                            <time datetime="2017-07-13">Jul. 13, 2017 &bull; Thumbtack</time>
                        </footer>
                    </article>

                    <article class="review-card">
                        <div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <h2 class="review-title">
                            <a target="_blank" rel="noopener noreferrer" href="https://www.thebash.com/string-quartet/arioso-quartet/feedback">
                                &ldquo;One of the Best Choices I Made Towards My June 2016 Wedding By FAR.&rdquo;
                            </a>
                        </h2>
                        <blockquote class="review-body">
                            I absolutely loved having the Arioso String Quartet play for my church wedding ceremony! This was one of the best choices I made towards my June 2016 wedding by FAR. Their prices are very reasonable and their communication and professionalism leading up to the big day was the best of ALL my vendors for my wedding. They were very flexible with my indecisiveness and were always happy to offer suggestions or consider my special requests. Despite my church being picky about our music selection and requiring us to change our music choices many times, Arioso was nothing but professional and patient through it all. They were absolutely wonderful. Highly recommended!
                        </blockquote>
                        <footer class="review-footer">
                            <strong>Theresa B.</strong>
                            <time datetime="2016-06-04">Jun. 4, 2016</time>
                        </footer>
                    </article>

                    <article class="review-card">
                        <div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <h2 class="review-title">
                            <a target="_blank" rel="noopener noreferrer" href="https://www.thebash.com/string-quartet/arioso-quartet/feedback">
                                &ldquo;You Cannot Go Wrong With Arioso. They Are The Best&rdquo;
                            </a>
                        </h2>
                        <blockquote class="review-body">
                            Simply awesome. Weddings and the choices are tough. You cannot go wrong with Arioso. They are the best. Thank you for a wonderful wedding and event.
                        </blockquote>
                        <footer class="review-footer">
                            <strong>Chiho N.</strong>
                            <time datetime="2015-10-17">Oct. 17, 2015</time>
                        </footer>
                    </article>

                    <article class="review-card">
                        <div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <h2 class="review-title">
                            <a target="_blank" rel="noopener noreferrer" href="https://www.thebash.com/string-quartet/arioso-quartet/feedback">
                                &ldquo;Exactly What We Wanted&rdquo;
                            </a>
                        </h2>
                        <blockquote class="review-body">
                            Carol and company were professional, accommodating, and extremely talented. They added a touch of elegance to our wedding. We had no rehearsal time, but did exactly what we wanted as if we practiced for months. I hope I need to hire them again. And with 5 girls I'm sure I will.
                        </blockquote>
                        <footer class="review-footer">
                            <strong>Mark B.</strong>
                            <time datetime="2014-03-22">Mar. 22, 2014</time>
                        </footer>
                    </article>

                    <article class="review-card">
                        <div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <h2 class="review-title">
                            <a target="_blank" rel="noopener noreferrer" href="https://www.thebash.com/string-quartet/arioso-quartet/feedback">
                                &ldquo;Arrived Early With a Smile&rdquo;
                            </a>
                        </h2>
                        <blockquote class="review-body">
                            Arioso made our wedding ceremony so romantic and lovely. It added such a special element to our whole day and I would recommend them again and again! Our weather was snowy and icy and they arrived early with a smile. Thank you so much!
                        </blockquote>
                        <footer class="review-footer">
                            <strong>Karen L.</strong>
                            <time datetime="2013-12-14">Dec. 14, 2013</time>
                        </footer>
                    </article>

                    <article class="review-card">
                        <div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <h2 class="review-title">
                            <a target="_blank" rel="noopener noreferrer" href="https://www.thebash.com/string-quartet/arioso-quartet/feedback">
                                &ldquo;A Pleasure to Work With&rdquo;
                            </a>
                        </h2>
                        <blockquote class="review-body">
                            5 Stars! Arioso Quartet performed during my wedding ceremony and cocktail hour and everything went smoothly. Carol was a pleasure to work with in the weeks leading up to the ceremony. She sent me a demo CD so that I could hear some of Arioso's work which was great. Thanks Arioso!
                        </blockquote>
                        <footer class="review-footer">
                            <strong>Annie M.</strong>
                            <time datetime="2013-06-08">Jun. 8, 2013</time>
                        </footer>
                    </article>

                    <article class="review-card">
                        <div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <h2 class="review-title">
                            <a target="_blank" rel="noopener noreferrer" href="https://www.thebash.com/string-quartet/arioso-quartet/feedback">
                                &ldquo;Loved Every Moment&rdquo;
                            </a>
                        </h2>
                        <blockquote class="review-body">
                            WOW!! Loved every moment and so thrilled we booked Arioso. Extremely professional, accommodating, and music was beautiful! Arioso was on top of all questions and replied to everything immediately. The special pieces that they were able to do for my daughter's wedding brought tears to my eyes that made the whole ceremony and cocktail hour the absolute best that I will never forget! Guests had high praises and will highly recommend to anyone who is not sure, to just book Arioso - you will be so happy you did! Great job Carol!
                        </blockquote>
                        <footer class="review-footer">
                            <strong>Peggy L.</strong>
                            <time datetime="2011-05-14">May 14, 2011</time>
                        </footer>
                    </article>

                    <article class="review-card">
                        <div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <h2 class="review-title">
                            <a target="_blank" rel="noopener noreferrer" href="https://www.thebash.com/string-quartet/arioso-quartet/feedback">
                                &ldquo;Everything We Hoped For and More&rdquo;
                            </a>
                        </h2>
                        <blockquote class="review-body">
                            Arioso was everything we hoped for and more. They added just the right touch to our daughter's wedding. We had some special requests for songs at the church they were not familiar with and they went above and beyond to learn the music and make the songs special for us. I already told them we wish we had more daughters' weddings to plan. We would definitely be using them again.
                        </blockquote>
                        <footer class="review-footer">
                            <strong>Lori M.</strong>
                            <time datetime="2010-11-06">Nov. 6, 2010</time>
                        </footer>
                    </article>
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/footer.ejs') %>
</body>
</html>
