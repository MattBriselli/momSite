<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head.ejs', {
        canonicalPath: '/',
        pageTitle: 'Philadelphia Wedding & Event String Musicians',
        pageDescription: 'The Arioso String Quartet offers live string quartet, trio, and duo music for weddings, ceremonies, cocktail hours, and events across Philadelphia, Southern NJ, and Delaware.'
    }) %>
</head>
<body>
    <%- include('../partials/header.ejs', { activePage: 'index' }) %>

    <main id="main-content">
        <!-- Hero -->
        <section class="hero-section">
            <div class="container hero-grid">
                <div class="hero-copy">
                    <div class="eyebrow-badge">
                        <span>Greater Philadelphia &bull; Southern NJ &bull; Delaware</span>
                    </div>
                    <h1 class="hero-title">Live String Music for Weddings &amp; Events in Greater Philadelphia</h1>
                    <p class="hero-lead">
                        We perform with <strong>Opera Philadelphia</strong>, the <strong>Philadelphia Ballet</strong>, and the <strong>Chamber Orchestra of Philadelphia</strong>, and we bring the highest caliber of musicianship to every event.
                        With over 25 years of ceremony experience, we play weddings, cocktail hours, Bar/Bat Mitzvahs, and private parties.
                    </p>
                    <div class="hero-actions">
                        <a href="/rates#inquiry-form" class="btn btn-primary">Check your date</a>
                        <a href="/music#samples" class="btn btn-secondary">
                            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7L8 5Z"/></svg>
                            <span>Listen to samples</span>
                        </a>
                    </div>
                    <div class="hero-trust-row">
                        <div class="trust-stat">
                            <strong>25+ Years</strong>
                            <span>Playing Together</span>
                        </div>
                        <div class="trust-divider" aria-hidden="true"></div>
                        <div class="trust-stat">
                            <strong>Hundreds</strong>
                            <span>of Weddings Played</span>
                        </div>
                        <div class="trust-divider" aria-hidden="true"></div>
                        <div class="trust-stat">
                            <strong>Quartet, Trio &amp; Duo</strong>
                            <span>Custom Ensembles</span>
                        </div>
                    </div>
                </div>

                <div class="hero-media">
                    <div class="hero-photo-frame">
                        <img
                            src="/img/arioso_quartet.jpg"
                            srcset="/img/optimized/arioso_quartet-640.jpg 640w, /img/arioso_quartet.jpg 1177w"
                            sizes="(min-width: 58rem) 34rem, calc(100vw - 3.5rem)"
                            alt="The four musicians of the Arioso String Quartet holding their cello, violins, and viola in formal concert attire"
                            width="1177"
                            height="1098"
                            fetchpriority="high"
                            class="hero-photo"
                        >
                        <div class="hero-caption">
                            <span>Vivian Barton (Cello), Igor Szwec (Violin), Barbara Jaffe (Violin) &amp; Carol Briselli (Viola)</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Awards -->
        <section class="awards-banner" aria-label="Awards">
            <div class="container awards-banner-inner">
                <div class="awards-banner-text">
                    <span class="awards-kicker">Award-Winning on The Bash</span>
                    <p>Best of, Rapid Responder, 25 Years, and Lifetime awards from our clients.</p>
                </div>
                <a class="awards-badges" href="https://www.thebash.com/string-quartet/arioso-quartet" target="_blank" rel="noopener noreferrer">
                    <img src="/img/awards/bash-25.svg" alt="The Bash 25 Years Member" width="64" height="64">
                    <img src="/img/awards/bash-best-of.svg" alt="The Bash Best Of Award" width="64" height="64">
                    <img src="/img/awards/bash-lifetime-award.svg" alt="The Bash Lifetime Award" width="64" height="64">
                    <img src="/img/awards/bash-rapid.svg" alt="The Bash Rapid Responder" width="64" height="64">
                </a>
            </div>
        </section>

        <!-- What we offer -->
        <section class="section">
            <div class="container">
                <div class="section-header">
                    <span class="section-kicker">Tailored to Your Event</span>
                    <h2 class="section-title">Choose the Group That Fits Your Day</h2>
                </div>

                <div class="feature-grid">
                    <article class="feature-card">
                        <div class="feature-tag">Most Popular</div>
                        <h3>String Quartet, Trio &amp; Duo</h3>
                        <p>
                            We play as a <strong>string quartet</strong> (two violins, viola, and cello), a <strong>string trio</strong> (violin, viola, and cello), or a <strong>string duo</strong> (violin and cello). A <strong>flute</strong> can replace a violin at no extra charge, and we can add a <strong>trumpet</strong> and/or <strong>vocalist</strong> to your ceremony.
                        </p>
                        <a href="/rates" class="card-link">See rates &rarr;</a>
                    </article>

                    <article class="feature-card">
                        <div class="feature-tag">Seasoned Professionals</div>
                        <h3>The Highest-Caliber Musicians</h3>
                        <p>
                            <a href="/about">Our members</a> are experienced professionals who play with Opera Philadelphia, the Philadelphia Ballet, and the Chamber Orchestra of Philadelphia.
                        </p>
                        <a href="/about" class="card-link">Meet our musicians &rarr;</a>
                    </article>

                    <article class="feature-card">
                        <div class="feature-tag">Every Denomination &amp; Venue</div>
                        <h3>Ceremony &amp; Reception Experts</h3>
                        <p>
                            We are experts at ceremonies of every denomination, including full Catholic Masses (with or without singers) and Jewish ceremonies, as well as Bar/Bat Mitzvahs, cocktail hours, private parties, and concerts. We gladly help you select your program and arrange custom requests. There may be a slight charge to purchase and arrange custom requests, which is calculated based on the complexity of the music.
                        </p>
                        <a href="/about#venues" class="card-link">Venues we've played &rarr;</a>
                    </article>
                </div>
            </div>
        </section>

        <!-- Repertoire highlights -->
        <section class="section section-tinted">
            <div class="container">
                <div class="section-header">
                    <span class="section-kicker">Extensive Musical Library</span>
                    <h2 class="section-title">Music for Every Moment</h2>
                    <p class="section-subtitle">
                        We are always adding new music, and we are happy to play special requests.
                    </p>
                </div>

                <div class="genre-grid">
                    <a href="/music#classical" class="genre-card">
                        <span class="genre-name">Classical</span>
                        <span class="genre-meta">Bach, Mozart, Haydn, Vivaldi, Handel &amp; more</span>
                    </a>
                    <a href="/music#wedding" class="genre-card">
                        <span class="genre-name">Wedding Ceremony</span>
                        <span class="genre-meta">Pachelbel Canon, processionals &amp; recessionals</span>
                    </a>
                    <a href="/music#popular" class="genre-card">
                        <span class="genre-name">Pop &amp; Modern Hits</span>
                        <span class="genre-meta">Coldplay, Elvis, Sinatra, U2, Lady Gaga &amp; more</span>
                    </a>
                    <a href="/music#showtunes" class="genre-card">
                        <span class="genre-name">Broadway &amp; Film</span>
                        <span class="genre-meta">La La Land, Star Wars, The Lord of the Rings &amp; more</span>
                    </a>
                    <a href="/music#jazz" class="genre-card">
                        <span class="genre-name">Jazz Classics</span>
                        <span class="genre-meta">Cole Porter, Gershwin, Duke Ellington</span>
                    </a>
                    <a href="/music#catholic" class="genre-card">
                        <span class="genre-name">Catholic, Jewish &amp; Hymns</span>
                        <span class="genre-meta">Mass music, Jewish songs, hymns &amp; more</span>
                    </a>
                </div>

                <div class="section-cta-row">
                    <a href="/music#repertoire" class="btn btn-primary">Search our full repertoire</a>
                    <a href="/music#samples" class="btn btn-secondary">Listen to samples</a>
                </div>
            </div>
        </section>

        <!-- Testimonial -->
        <section class="section">
            <div class="container split-callout">
                <div class="callout-image-wrap">
                    <img
                        src="/img/playing.jpeg"
                        srcset="/img/optimized/playing-560.jpg 560w, /img/playing.jpeg 874w"
                        sizes="(min-width: 54rem) 34rem, calc(100vw - 4rem)"
                        alt="Arioso String Quartet performing outdoors at a wedding ceremony"
                        width="874"
                        height="612"
                        loading="lazy"
                        class="callout-image"
                    >
                </div>
                <div class="callout-content">
                    <span class="section-kicker">Client Praise</span>
                    <blockquote class="featured-quote">
                        &ldquo;Arioso Quartet was the perfect addition to our wedding ceremony! They added just the touch of elegance we were looking for. Carol was easy to communicate with and helpful in choosing our music for both the ceremony and cocktail hour&hellip; We received so many compliments throughout the night!&rdquo;
                    </blockquote>
                    <p class="quote-attribution">&mdash; Casey H., Wedding Client &bull; <a href="/reviews">Read more reviews</a></p>

                    <div class="contact-prompt-box">
                        <h3>Planning a Wedding or Special Event?</h3>
                        <p>
                            <a href="/rates#inquiry-form">Check your date online</a>, email Carol Briselli at
                            <a href="mailto:carol@ariosoquartet.com">carol@ariosoquartet.com</a>, or call
                            <a href="tel:+14848416445">(484) 841-6445</a>.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/footer.ejs') %>
</body>
</html>
