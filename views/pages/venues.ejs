<%
  const allVenues = typeof venuesData !== 'undefined' ? venuesData : [];
  const regions = typeof regionMeta !== 'undefined' ? regionMeta : {};
  const shortCategoryLabels = {
    estates: 'Estate / Club',
    hotels: 'Hotel',
    worship: 'House of Worship'
  };

  const venuesSchema = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Selected Wedding & Event Venues Played by Arioso String Quartet',
    numberOfItems: allVenues.length,
    itemListElement: allVenues.map((v, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      item: {
        '@type': 'Place',
        name: v.name,
        address: {
          '@type': 'PostalAddress',
          addressLocality: v.city,
          addressRegion: v.state,
          addressCountry: 'US'
        }
      }
    }))
  };
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head.ejs', {
        canonicalPath: '/venues',
        pageTitle: 'Philadelphia, Main Line, NJ & DE Wedding Venues',
        pageDescription: 'Explore 85+ mansions, estates, country clubs, luxury hotels, churches, and synagogues across Philadelphia, the Main Line, Bucks/Chester/Montgomery Counties, NJ, and Delaware where the Arioso String Quartet performs.',
        extraJsonLd: venuesSchema
    }) %>
</head>
<body>
    <%- include('../partials/header.ejs', { activePage: 'venues' }) %>

    <main id="main-content">
        <section class="page-hero">
            <div class="container">
                <span class="section-kicker">Where We Perform</span>
                <h1 class="page-heading">Selected Venues Across Greater Philadelphia, NJ &amp; Delaware</h1>
                <p class="page-intro">
                    Over the past two decades, the Arioso String Quartet has performed at hundreds of historic mansions, gardens, country clubs, luxury hotels, churches, and synagogues within 80 miles of Center City Philadelphia.
                </p>

                <search class="venue-controls" aria-label="Search and filter venues">
                    <div class="search-input-wrap">
                        <svg class="icon search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5Zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Z"/></svg>
                        <input
                            type="search"
                            id="venue-search"
                            class="search-input"
                            placeholder="Search venue or town (e.g., Winterthur, Cairnwood, Doylestown, Rittenhouse)..."
                            aria-label="Search venues or towns"
                            autocorrect="off"
                            autocapitalize="none"
                            spellcheck="false"
                        >
                    </div>

                    <div class="filter-group-stack">
                        <div class="filter-row">
                            <span class="filter-row-label">Region:</span>
                            <div class="filter-pills" role="group" aria-label="Filter venues by region">
                                <button type="button" class="filter-pill is-active" data-region-filter="all">All Regions (<%= allVenues.length %>)</button>
                                <button type="button" class="filter-pill" data-region-filter="philadelphia">Philadelphia</button>
                                <button type="button" class="filter-pill" data-region-filter="pa-suburbs">Main Line &amp; PA Suburbs</button>
                                <button type="button" class="filter-pill" data-region-filter="delaware">Wilmington &amp; Delaware</button>
                                <button type="button" class="filter-pill" data-region-filter="new-jersey">New Jersey &amp; Shore</button>
                                <button type="button" class="filter-pill" data-region-filter="greater-region">Lehigh Valley, Hershey &amp; MD</button>
                            </div>
                        </div>

                        <div class="filter-row">
                            <span class="filter-row-label">Type:</span>
                            <div class="filter-pills" role="group" aria-label="Filter venues by venue type">
                                <button type="button" class="filter-pill is-active" data-venue-filter="all">All Types</button>
                                <button type="button" class="filter-pill" data-venue-filter="estates">Mansions, Estates &amp; Clubs</button>
                                <button type="button" class="filter-pill" data-venue-filter="hotels">Hotels</button>
                                <button type="button" class="filter-pill" data-venue-filter="worship">Churches &amp; Synagogues</button>
                            </div>
                        </div>
                    </div>
                </search>
            </div>
        </section>

        <section class="section">
            <div class="container">
                <div class="venues-sections" id="venues-container">
                    <% Object.entries(regions).forEach(([regionKey, regionTitle]) => {
                        const regionVenues = allVenues.filter((v) => v.region === regionKey);
                    %>
                    <article class="venue-category-card" data-venue-region="<%= regionKey %>">
                        <header class="venue-category-header">
                            <h2><%= regionTitle %></h2>
                            <span class="venue-count" data-region-count><%= regionVenues.length %> Venues</span>
                        </header>
                        <ul class="venue-list">
                            <% regionVenues.forEach((venue) => { %>
                            <li data-item-category="<%= venue.category %>">
                                <div class="venue-item-top">
                                    <strong><%= venue.name %></strong>
                                    <span class="venue-type-chip"><%= shortCategoryLabels[venue.category] %></span>
                                </div>
                                <span><%= venue.city %>, <%= venue.state %></span>
                            </li>
                            <% }) %>
                        </ul>
                    </article>
                    <% }) %>
                </div>

                <p id="venue-no-results" class="empty-state" hidden>
                    No listed venues match your current filter—however, we perform at any indoor or shaded outdoor location within 80 miles of Center City Philadelphia! <a href="/rates#inquiry-form">Inquire about your venue</a>.
                </p>
            </div>
        </section>
    </main>

    <%- include('../partials/footer.ejs') %>
</body>
</html>
